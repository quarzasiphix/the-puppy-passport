# Committed on purpose. These are the PUBLIC Supabase values:
#   - VITE_SUPABASE_URL       — the project's public API URL
#   - VITE_SUPABASE_ANON_KEY  — the "anon" role key, designed to ship in the browser bundle
#                               (RLS is the real security boundary, never this key)
#
# Vite inlines every VITE_* var at BUILD time. A production build without these produces a
# bundle whose src/lib/supabase/browser.ts throws at module load ("Missing VITE_SUPABASE_*"),
# which Cloudflare surfaces as an unhandled 500 on every route. Keeping them here means every
# build — local, CI, Cloudflare — has them with zero dashboard configuration.
#
# Real secrets (service_role key, SUPABASE_AUTH_* OAuth client secrets) must NEVER go in this
# file — those stay in the deploy platform's encrypted secret store.
VITE_SUPABASE_URL=https://pgzvkkybqrhxedjoyjzy.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InBnenZra3licXJoeGVkam95anp5Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODcxODI4NTIsImV4cCI6MjEwMjc1ODg1Mn0.Jbqq1AlQK545wup_dq2dyLLbPzrclrZip9RUuGov7qk
