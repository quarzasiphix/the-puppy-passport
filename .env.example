# Copy this file to .env and fill in the values printed by `supabase start` (or `supabase status`
# if the stack is already running). See LOCAL_SETUP.md for the full walkthrough.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_ANON_KEY=

# PostHog client analytics (public project token and ingestion host)
VITE_PUBLIC_POSTHOG_PROJECT_TOKEN=<ph_project_token>
VITE_PUBLIC_POSTHOG_HOST=<ph_client_api_host>

# Optional — only needed once you configure real Google/Facebook OAuth apps for local testing.
# Until these are set, the sign-in buttons for Google/Facebook will show a clear "not configured"
# message instead of a fake success state. See LOCAL_SETUP.md for how to obtain them.
SUPABASE_AUTH_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_GOOGLE_SECRET=
SUPABASE_AUTH_FACEBOOK_CLIENT_ID=
SUPABASE_AUTH_FACEBOOK_SECRET=

# Reservation deposit (zaliczka) payments — NOT env vars for this app itself. These are Supabase
# Edge Function secrets, set via `supabase secrets set STRIPE_SECRET_KEY=... --project-ref <ref>`
# (or the dashboard) once a real Stripe account exists, never committed here or shipped to the
# browser. Until they're set, supabase/functions/create-deposit-checkout-session and
# supabase/functions/stripe-webhook both return a clear 503 "not configured" instead of a fake
# success — see docs/RESERVATION_PAYMENT_DESIGN.md.
#   STRIPE_SECRET_KEY
#   STRIPE_WEBHOOK_SECRET  (from the Stripe Dashboard webhook endpoint for checkout.session.completed
#                            and checkout.session.expired, pointed at the stripe-webhook function URL)
